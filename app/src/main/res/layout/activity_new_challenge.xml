<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp">

    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Challenge a friend" android:textSize="22sp" android:textStyle="bold" />

    <EditText android:id="@+id/etEmail"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="Friend's email (the one they sign in with)"
        android:inputType="textEmailAddress" />

    <EditText android:id="@+id/etTarget"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:hint="Daily step target"
        android:text="8000" android:inputType="number" />

    <Button android:id="@+id/btnSend"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:text="Send challenge" />

    <ProgressBar android:id="@+id/progress"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:visibility="gone" />
</LinearLayout>