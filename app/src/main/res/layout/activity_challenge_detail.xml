<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp">

    <TextView android:id="@+id/tvTitle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="22sp" android:textStyle="bold" android:gravity="center" />

    <TextView android:id="@+id/tvTarget"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:gravity="center" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="32dp" android:text="You" android:textStyle="bold" />
    <ProgressBar android:id="@+id/barMe" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="24dp" android:layout_marginTop="4dp" />
    <TextView android:id="@+id/tvMe"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" />

    <TextView android:id="@+id/tvFriendLabel"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:textStyle="bold" />
    <ProgressBar android:id="@+id/barFriend" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="24dp" android:layout_marginTop="4dp" />
    <TextView android:id="@+id/tvFriend"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" />

    <TextView android:id="@+id/tvStatus"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="32dp" android:gravity="center" android:textSize="16sp" />
</LinearLayout>